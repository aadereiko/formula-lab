# Copy to .env and fill in. Never commit the real file.

# Required in production. Signs session cookies -- changing it logs everyone out.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
FORMULA_LAB_SECRET=

# Where the app is reachable. Used for the post-sign-in redirect.
FORMULA_LAB_APP_URL=http://localhost:7731/

# Enables HTTPS-only cookies and refuses to boot without a secret.
FORMULA_LAB_ENV=production

# SQLite by default. For Postgres:
#   postgresql+psycopg://user:password@host:5432/formula_lab
FORMULA_LAB_DATABASE_URL=sqlite:////data/formula_lab.db

# Google sign-in (optional). Leave blank to offer email/password only.
FORMULA_LAB_GOOGLE_CLIENT_ID=
FORMULA_LAB_GOOGLE_CLIENT_SECRET=
FORMULA_LAB_GOOGLE_REDIRECT_URI=http://localhost:7731/api/auth/google/callback
